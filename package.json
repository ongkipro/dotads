{
  "name": "dotads-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo check",
    "test": "turbo test",
    "db:generate": "pnpm --filter @dotads/db db:generate",
    "db:migrate": "pnpm --filter @dotads/db db:migrate",
    "db:seed": "pnpm --filter @dotads/db db:seed",
    "smoke:release": "node --experimental-strip-types --input-type=module -e \"import './scripts/smoke-release.ts'\""
  },
  "dependencies": {
    "@dotads/contracts": "workspace:*",
    "@dotads/db": "workspace:*",
    "@dotads/integrations": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
