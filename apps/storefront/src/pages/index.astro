---
const title = "Headphone Pro Max Wireless ANC | Alpha Store";
const description = "Pesan Headphone Pro Max Wireless ANC dengan pilihan COD, QRIS, atau Virtual Account dan pengiriman ke seluruh Indonesia.";
const apiHost = import.meta.env.PUBLIC_API_URL || "http://localhost:8787";
const tenantId = import.meta.env.PUBLIC_TENANT_ID || "2f2ca823-46bf-4ab5-a5fe-61a49d175fa8";
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" as="image" href="/images/products/headphone-pro-max-studio.webp" type="image/webp" />

    {metaPixelId && (
      <script is:inline define:vars={{ metaPixelId }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <script>import '@dotads/form-runtime';</script>

    <style>
      :root {
        color-scheme: light;
        --canvas: #f8fafc;
        --surface: #ffffff;
        --surface-muted: #f1f5f9;
        --ink: #0f172a;
        --ink-secondary: #475569;
        --ink-muted: #64748b;
        --border: #dbe3ed;
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --radius: 12px;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a, button { -webkit-tap-highlight-color: transparent; }
      a:focus-visible, button:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.35);
        outline-offset: 3px;
      }
      .site-header {
        border-bottom: 1px solid var(--border);
        background: rgba(248, 250, 252, 0.94);
      }
      .header-inner,
      .container {
        width: min(100% - 32px, 1120px);
        margin-inline: auto;
      }
      .header-inner {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .brand { font-size: 1rem; font-weight: 800; letter-spacing: -0.02em; }
      .support-link { color: var(--ink-secondary); font-size: 0.9rem; font-weight: 650; text-decoration: none; }
      .hero { padding: 48px 0 40px; }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
        gap: clamp(32px, 6vw, 72px);
        align-items: center;
      }
      .product-visual {
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-muted);
        aspect-ratio: 1;
      }
      .product-visual img { width: 100%; height: 100%; display: block; object-fit: cover; }
      .eyebrow { margin: 0 0 10px; color: var(--primary); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
      h1 { margin: 0; max-width: 15ch; font-size: clamp(2rem, 1.35rem + 2.6vw, 3.75rem); line-height: 1.04; letter-spacing: -0.045em; }
      .lead { max-width: 58ch; margin: 20px 0 0; color: var(--ink-secondary); font-size: 1.05rem; }
      .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-top: 24px; }
      .price { font-size: 1.8rem; font-weight: 850; letter-spacing: -0.03em; }
      .compare-price { color: var(--ink-muted); text-decoration: line-through; }
      .primary-cta {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 24px;
        padding: 12px 20px;
        border-radius: 10px;
        background: var(--primary);
        color: #ffffff;
        font-weight: 750;
        text-decoration: none;
        transition: background-color 160ms ease, transform 160ms ease;
      }
      .primary-cta:hover { background: var(--primary-hover); }
      .primary-cta:active { transform: scale(0.98); }
      .purchase-notes { display: grid; gap: 10px; margin: 22px 0 0; padding: 0; list-style: none; color: var(--ink-secondary); font-size: 0.92rem; }
      .purchase-notes li { display: flex; gap: 10px; }
      .purchase-notes li::before { content: "✓"; color: #15803d; font-weight: 850; }
      .checkout-section { padding: 40px 0 96px; }
      .checkout-shell { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(360px, 1fr); gap: clamp(24px, 5vw, 56px); align-items: start; }
      .checkout-copy { position: sticky; top: 24px; }
      h2 { margin: 0; font-size: clamp(1.5rem, 1.25rem + 1vw, 2.25rem); line-height: 1.15; letter-spacing: -0.03em; }
      .checkout-copy p { margin: 16px 0 0; color: var(--ink-secondary); }
      .checkout-steps { margin: 24px 0 0; padding-left: 20px; color: var(--ink-secondary); }
      .checkout-steps li + li { margin-top: 10px; }
      #checkout-form { scroll-margin-top: 24px; min-width: 0; }
      dotads-form:not(:defined) {
        display: block;
        min-height: 520px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 50%, #eef2f7 75%);
        background-size: 200% 100%;
        animation: skeleton 1.4s ease-in-out infinite;
      }
      .sticky-mobile-cta {
        position: fixed;
        inset: auto 0 0;
        z-index: 30;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-top: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.96);
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
        box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.1);
        backdrop-filter: blur(12px);
      }
      .sticky-product { min-width: 0; }
      .sticky-product span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .sticky-product span:first-child { color: var(--ink-muted); font-size: 0.75rem; }
      .sticky-product span:last-child { color: var(--ink); font-size: 0.95rem; font-weight: 800; }
      .sticky-mobile-cta .primary-cta { flex: 0 0 auto; margin: 0; min-height: 44px; padding: 10px 14px; font-size: 0.9rem; }
      @keyframes skeleton { to { background-position: -200% 0; } }
      @media (max-width: 767px) {
        .hero { padding: 28px 0 32px; }
        .hero-grid { grid-template-columns: 1fr; gap: 28px; }
        .product-visual { order: -1; }
        .checkout-shell { grid-template-columns: 1fr; }
        .checkout-copy { position: static; }
        .checkout-section { padding-top: 24px; padding-bottom: 112px; }
        .sticky-mobile-cta { display: flex; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <span class="brand">Alpha Store</span>
        <a class="support-link" href="#checkout-form">Bantuan pemesanan</a>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="product-title">
        <div class="container hero-grid">
          <div>
            <p class="eyebrow">Produk demo Alpha Store</p>
            <h1 id="product-title">Headphone Pro Max Wireless ANC</h1>
            <p class="lead">Headphone noise-cancelling dengan koneksi nirkabel dan daya baterai hingga 40 jam.</p>
            <div class="price-row" aria-label="Harga produk">
              <span class="price">Rp1.499.000</span>
              <span class="compare-price">Rp1.999.000</span>
            </div>
            <a href="#checkout-form" class="primary-cta">Isi Data Pesanan</a>
            <ul class="purchase-notes">
              <li>Pilih pembayaran COD, QRIS, atau Virtual Account.</li>
              <li>Konfirmasi pesanan dikirim melalui WhatsApp.</li>
              <li>Kurir tersedia sesuai alamat tujuan.</li>
            </ul>
          </div>
          <figure class="product-visual">
            <img src="/images/products/headphone-pro-max-studio.webp" width="1000" height="1000" alt="Headphone Pro Max Wireless ANC berwarna biru gelap" />
          </figure>
        </div>
      </section>

      <section class="checkout-section" aria-labelledby="checkout-title">
        <div class="container checkout-shell">
          <div class="checkout-copy">
            <h2 id="checkout-title">Lengkapi data pesanan</h2>
            <p>Pastikan nomor WhatsApp dan alamat aktif agar konfirmasi serta pengiriman tidak tertunda.</p>
            <ol class="checkout-steps">
              <li>Isi nama dan nomor WhatsApp.</li>
              <li>Lengkapi alamat, kurir, dan metode pembayaran.</li>
              <li>Periksa kembali lalu konfirmasi pesanan.</li>
            </ol>
          </div>
          <div id="checkout-form">
            <dotads-form tenant-id={tenantId} api-host={apiHost} mode="hybrid"></dotads-form>
          </div>
        </div>
      </section>
    </main>

    <div class="sticky-mobile-cta" aria-label="Ringkasan pembelian">
      <div class="sticky-product">
        <span>Headphone Pro Max</span>
        <span>Rp1.499.000</span>
      </div>
      <a href="#checkout-form" class="primary-cta">Isi Data Pesanan</a>
    </div>
  </body>
</html>
